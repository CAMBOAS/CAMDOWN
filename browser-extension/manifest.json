{
  "manifest_version": 3,
  "name": "CAMDOWN",
  "version": "1.0.0",
  "description": "One-click video download for Facebook, YouTube, TikTok, Instagram, and Pinterest via your local CAMDOWN app.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["activeTab"],
  "host_permissions": ["http://127.0.0.1:5000/*"],
  "content_scripts": [
    {
      "matches": [
        "*://*.facebook.com/*",
        "*://*.fb.watch/*",
        "*://*.youtube.com/*",
        "*://youtu.be/*",
        "*://*.tiktok.com/*",
        "*://*.instagram.com/*",
        "*://*.pinterest.com/*",
        "*://*.pin.it/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
